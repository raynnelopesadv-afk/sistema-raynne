# =============================================================================
# BI Suite — variaveis de ambiente
# Copie este arquivo para .env  (cp .env.example .env)  e preencha os valores.
# NUNCA comite o .env real: ele ja esta no .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# FRONTEND (Vite) — obrigatorias
# Sao chaves PUBLICAS (anon), seguras para expor no navegador.
# Onde achar: Supabase > Project Settings > API.
#   VITE_SUPABASE_URL          = "Project URL"
#   VITE_SUPABASE_ANON_KEY     = "anon public" key
#   VITE_SUPABASE_PROJECT_ID   = o "Reference ID" do projeto (parte do URL)
# Configure as MESMAS variaveis no painel da Vercel (Settings > Environment Variables).
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_ANON_KEY_AQUI
VITE_SUPABASE_PUBLISHABLE_KEY=SUA_ANON_KEY_AQUI
VITE_SUPABASE_PROJECT_ID=SEU_PROJECT_REF_AQUI

# =============================================================================
# EDGE FUNCTIONS (Supabase) — NAO vao neste arquivo em producao.
# Configure com:  supabase secrets set NOME=valor --project-ref SEU_PROJECT_REF
# Listadas aqui apenas como referencia do que cada integracao precisa.
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY / SUPABASE_ANON_KEY sao injetadas
# automaticamente pela Supabase nas functions (nao precisa setar).
# =============================================================================

# --- Integracao Liderhub (WhatsApp/CRM de atendimento) - opcional ---
# Chave da empresa no Liderhub (header x-company-key).
LIDERHUB_COMPANY_KEY=SEU_LIDERHUB_COMPANY_KEY

# --- Integracao Meta Ads - opcional ---
# Token de acesso da Meta (system user com ads_read/read_insights).
META_ACCESS_TOKEN=SEU_META_ACCESS_TOKEN
# ID da conta de anuncios, no formato act_XXXXXXXXXX.
META_AD_ACCOUNT_ID=act_XXXXXXXXXX

# --- Seguranca dos jobs agendados (cron) ---
# Segredo compartilhado que o cron envia no header para disparar os syncs.
# Gere um valor aleatorio (ex.: openssl rand -hex 24).
CRON_SECRET=GERAR_UM_SEGREDO_ALEATORIO
CRON_TOKEN=GERAR_UM_SEGREDO_ALEATORIO

# --- Webhook de atribuicao de leads de formulario - opcional ---
# Segredo que a automacao da agencia envia no header x-webhook-secret.
# Gere um valor aleatorio (ex.: openssl rand -hex 24).
ATTRIBUTION_WEBHOOK_SECRET=GERAR_UM_SEGREDO_ALEATORIO
